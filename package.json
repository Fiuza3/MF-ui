{
  "name": "@fiuza3/mf-ui",
  "version": "3.0.2",
  "description": "Design system compartilhado da MF Desenvolvimento",
  "author": "Marcus Fiuza <devfiuza@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fiuza3/MF-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens": {
      "import": "./dist/tokens/index.mjs",
      "require": "./dist/tokens/index.js",
      "types": "./dist/tokens/index.d.ts"
    },
    "./primitivos": {
      "import": "./dist/primitivos/index.mjs",
      "require": "./dist/primitivos/index.js",
      "types": "./dist/primitivos/index.d.ts"
    },
    "./blocos": {
      "import": "./dist/blocos/index.mjs",
      "require": "./dist/blocos/index.js",
      "types": "./dist/blocos/index.d.ts"
    },
    "./blocos-app": {
      "import": "./dist/blocos-app/index.mjs",
      "require": "./dist/blocos-app/index.js",
      "types": "./dist/blocos-app/index.d.ts"
    },
    "./globals.css": "./src/tokens/globals.css",
    "./utilitarios.css": "./src/tokens/utilitarios.css"
  },
  "files": [
    "dist",
    "src",
    "!src/testes",
    "!src/blocos-app/__tests__",
    "!src/**/*.stories.tsx"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.storybook.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@radix-ui/react-accordion": ">=1.2",
    "@radix-ui/react-checkbox": ">=1.1",
    "@radix-ui/react-dialog": ">=1.1",
    "@radix-ui/react-dropdown-menu": ">=2.1",
    "@radix-ui/react-label": ">=2.1",
    "@radix-ui/react-select": ">=2.1",
    "@radix-ui/react-separator": ">=1.1",
    "@radix-ui/react-slot": ">=1.2",
    "@radix-ui/react-switch": ">=1.1",
    "@radix-ui/react-tabs": ">=1.1",
    "@radix-ui/react-toast": ">=1.2",
    "@radix-ui/react-tooltip": ">=1.2",
    "lucide-react": ">=0.400",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.0.0",
    "lucide-react": "^0.564.0",
    "prettier": "^3.9.6",
    "react": "^19",
    "react-dom": "^19",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.14",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
